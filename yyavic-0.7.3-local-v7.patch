 /*
  * Add an RSN element to a frame (see 802.11-2012 8.4.2.27)
  */
+/*
+ * Local patch (hotspot debugging): RSN Capabilities sent in the association
+ * request. The Windows Mobile Hotspot refuses both 0x003c (echo of its own
+ * value) and 0x0000 with status 45. Each status-45 refusal moves to the next
+ * variant, so the automatic retries try them all; the log names the one used.
+ * 0x0080 = MFP capable (no PMF is negotiated unless the AP is capable too).
+ */
+const u_int16_t yy_rsncaps_variants[YY_RSNCAPS_NVARIANTS] = {
+    0x0080, 0x008c, 0x00bc, 0x0000, 0x000c
+};
+volatile int yy_rsncaps_idx = 0;
+
 u_int8_t *
 ieee80211_add_rsn_body(u_int8_t *frm, struct ieee80211com *ic,
     const struct ieee80211_node *ni, int wpa)
@@ -1092,8 +1104,13 @@ ieee80211_add_rsn_body(u_int8_t *frm, struct ieee80211com *ic,
         return frm;
 
     /* write RSN Capabilities field */
-    rsncaps = (ni->ni_rsncaps & (IEEE80211_RSNCAP_PTKSA_RCNT_MASK |
-        IEEE80211_RSNCAP_GTKSA_RCNT_MASK));
+    /*
+     * Local patch: OpenBSD echoes the AP's PTKSA/GTKSA replay counter counts.
+     * The Windows Mobile Hotspot (RSN caps 0x3c, 16/16 counters) refuses that
+     * with status 45 (invalid RSN capabilities). As a station advertise the
+     * default single counters (0), as wpa_supplicant and Apple do.
+     */
+    rsncaps = yy_rsncaps_variants[yy_rsncaps_idx % YY_RSNCAPS_NVARIANTS];
     if (ic->ic_caps & IEEE80211_C_MFP) {
         rsncaps |= IEEE80211_RSNCAP_MFPC;
         if (ic->ic_flags & IEEE80211_F_MFPR)
@@ -1607,7 +1624,10 @@ ieee80211_get_assoc_req(struct ieee80211com *ic, struct ieee80211_node *ni,
 
 	frm = mtod(m, u_int8_t *);
 	capinfo = IEEE80211_CAPINFO_ESS;
-	if (ic->ic_flags & IEEE80211_F_WEPON)
+	/* Local patch: like Linux mac80211, set Privacy for an RSN/WPA network
+	 * too (OpenBSD sets it for WEP only); some APs refuse a mismatch. */
+	if ((ic->ic_flags & (IEEE80211_F_WEPON | IEEE80211_F_RSNON)) ||
+	    (ni->ni_capinfo & IEEE80211_CAPINFO_PRIVACY))
 		capinfo |= IEEE80211_CAPINFO_PRIVACY;
 	if ((ic->ic_flags & IEEE80211_F_SHPREAMBLE) &&
 	    IEEE80211_IS_CHAN_2GHZ(ni->ni_chan))
@@ -1626,6 +1646,7 @@ ieee80211_get_assoc_req(struct ieee80211com *ic, struct ieee80211_node *ni,
 		frm = ieee80211_add_xrates(frm, rs);
